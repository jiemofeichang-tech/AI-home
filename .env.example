APP_URL=http://localhost:3100
DATABASE_URL=postgresql://community:change-me@localhost:5432/community
POSTGRES_PASSWORD=replace-with-a-strong-database-password
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DEV_MODE=false
INVITE_ONLY=true
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
# New content stays private for manual review until cloud moderation is configured.
CONTENT_MODERATION_PROVIDER=manual
CONTENT_MODERATION_REGION=cn-shanghai
CONTENT_MODERATION_ACCESS_KEY_ID=
CONTENT_MODERATION_ACCESS_KEY_SECRET=
REDIS_URL=redis://localhost:6379
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=replace-with-random-search-key
STORAGE_DRIVER=oss
LOCAL_STORAGE_DIR=.local/uploads
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
ALI_ACCESS_KEY_ID=
ALI_ACCESS_KEY_SECRET=
# Personal accounts: aliyun-pnvs (PNVS SMS authentication).
# Existing enterprise SMS integrations: aliyun-sms. Unset defaults to aliyun-sms.
SMS_PROVIDER=aliyun-pnvs
# Dedicated SMS credentials; leave BOTH blank to use the ALI_ACCESS_KEY pair above.
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
# For PNVS, copy a matching system-provided signature and template from its console.
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-vl-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GITHUB_TOKEN=
AI_MONTHLY_IMAGE_LIMIT=1000
USER_DAILY_IMAGE_LIMIT=20
USER_DAILY_VIDEO_LIMIT=5
SMS_DAILY_LIMIT=100
ADMIN_PHONE=
BACKUP_DIR=backups
# Set only behind a reverse proxy that overwrites this header.
AUTH_IP_HEADER=
DB_POOL_SIZE=10
# Use deploy/compose.small.yaml for the lower limits recommended on a 2 GiB host.
WORKER_CONCURRENCY=3
IMAGE_UPLOAD_CONCURRENCY=2
IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_ANIMATION_FRAMES=200
IMAGE_MAX_ANIMATION_PIXELS=40000000
