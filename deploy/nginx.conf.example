# Install inside an HTTPS server block with your own certificate configuration.
# APP_URL must be the public HTTPS origin. The web port only binds to localhost.
location / {
    proxy_pass http://127.0.0.1:3100;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
    proxy_read_timeout 90s;
    client_max_body_size 12m;
}
# Use a privacy-conscious access_log format that excludes $args and Authorization.
